# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Deployed App URL - REQUIRED for password reset emails to work
# IMPORTANT: This must be your deployed Netlify URL, not a local or Bolt URL
# Password reset links will redirect users to this URL
# Examples:
#   - Netlify: https://your-app-name.netlify.app
#   - Custom domain: https://yourdomain.com
EXPO_PUBLIC_APP_URL=https://your-app.netlify.app
